{
  "name": "volumeguard-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && node scripts/dev.mjs",
    "build": "node init && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:dist",
    "preview": "npm run build && npx -y firebase-tools@latest emulators:start --only hosting --project teamvolumeguard"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "dotenv": "^8.2.0",
    "lenis": "1.3.27",
    "node-fetch": "^3.3.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "marked": "18.2.1",
    "typescript": "6.0.3"
  }
}
